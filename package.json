{
  "name": "webhooks-sdk",
  "version": "0.1.5",
  "description": "One way to verify, parse, and route webhooks from every provider.",
  "keywords": [
    "webhook",
    "webhooks",
    "signature",
    "hmac",
    "standard-webhooks",
    "svix",
    "stripe",
    "github",
    "twilio",
    "google-pubsub",
    "verification",
    "edge",
    "workers"
  ],
  "license": "MIT",
  "author": "Nico Genz",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "INTEGRATIONS.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./stripe": "./dist/providers/stripe/index.js",
    "./github": "./dist/providers/github/index.js",
    "./discord": "./dist/providers/discord/index.js",
    "./twilio": "./dist/providers/twilio/index.js",
    "./google-pubsub": "./dist/providers/google-pubsub/index.js",
    "./standard-webhooks": "./dist/providers/standard-webhooks/index.js",
    "./resend": "./dist/providers/resend/index.js",
    "./clerk": "./dist/providers/clerk/index.js",
    "./polar": "./dist/providers/polar/index.js",
    "./replicate": "./dist/providers/replicate/index.js",
    "./openai": "./dist/providers/openai/index.js",
    "./loops": "./dist/providers/loops/index.js",
    "./dodo-payments": "./dist/providers/dodo-payments/index.js",
    "./testing": "./dist/testing/index.js",
    "./next": "./dist/adapters/next.js",
    "./nuxt": "./dist/adapters/h3.js",
    "./nitro": "./dist/adapters/h3.js",
    "./h3": "./dist/adapters/h3.js",
    "./hono": "./dist/adapters/hono.js",
    "./express": "./dist/adapters/express.js",
    "./node": "./dist/adapters/node.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && publint",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "publint": "0.3.24",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicogenz/webhooks-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/nicogenz/webhooks-sdk/issues"
  },
  "homepage": "https://webhooks-sdk.com",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
